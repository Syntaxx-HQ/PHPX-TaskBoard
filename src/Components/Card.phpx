<?php

use Syntaxx\PHPX\Framework\Component;
use Syntaxx\PHPX\Framework\Runtime;
use function Syntaxx\PHPX\Framework\useState;

function Card($props) {
    $card = $props['card'];
    $onDelete = $props['onDelete'];
    $onUpdate = $props['onUpdate'];
    $onDragStart = $props['onDragStart'] ?? fn() => null;
    $onDragEnd = $props['onDragEnd'] ?? fn() => null;

    [$isEditing, $setIsEditing] = useState(false);
    [$editTitle, $setEditTitle] = useState($card['title']);
    [$isModalOpen, $setIsModalOpen] = useState(false);
    [$showDeleteConfirm, $setShowDeleteConfirm] = useState(false);

    // Handle title double-click to edit
    $handleTitleDoubleClick = function($e) use ($setIsEditing, $setEditTitle, $card) {
        $e->stopPropagation(); // Prevent propagation to card's onClick (modal)
        $setIsEditing(true);
        $setEditTitle($card['title']);
    };

    // Handle save edit
    $handleSaveEdit = fn() => (function() use ($onUpdate, $setIsEditing, $card) {
        // Read value directly from DOM input (state may not be updated yet)
        $window = new \Vrzno;
        $document = $window->document;
        $input = $document->querySelector('[data-testid="inline-edit-input"]');
        $title = $input ? trim($input->value) : '';

        if (!empty($title) && $title !== $card['title']) {
            $onUpdate(['title' => $title]);
        }
        $setIsEditing(false);
    })();

    // Handle cancel edit
    $handleCancelEdit = fn() => (
        $setEditTitle($card['title']) || $setIsEditing(false) || null
    );

    // Handle card click to open modal
    $handleCardClick = function($e) use ($isEditing, $setIsModalOpen) {
        // Check if click is on delete button (check className instead of closest)
        $isDeleteBtn = false;
        if (isset($e->target->className) && is_string($e->target->className)) {
            $isDeleteBtn = str_contains($e->target->className, 'delete-card-btn');
        }

        if (!$isEditing && !$isDeleteBtn) {
            $setIsModalOpen(true);
        }
    };

    // Handle delete button click
    $handleDeleteClick = fn($e) => (
        $e->stopPropagation() || $setShowDeleteConfirm(true) || null
    );

    // Handle confirm delete
    $handleConfirmDelete = fn() => (
        $onDelete() ||
        $setShowDeleteConfirm(false) ||
        $setIsModalOpen(false) ||
        null
    );

    // Handle cancel delete
    $handleCancelDelete = fn() => $setShowDeleteConfirm(false);

    // Get priority class
    $getPriorityClass = fn($priority) => match($priority) {
        'high' => 'priority-high',
        'medium' => 'priority-medium',
        'low' => 'priority-low',
        default => ''
    };

    // Get priority label
    $getPriorityLabel = fn($priority) => match($priority) {
        'high' => 'High',
        'medium' => 'Medium',
        'low' => 'Low',
        default => 'Medium'
    };

    return (
        <div className="card-wrapper">
            <div
                className="card"
                    data-testid={$card['id']}
                    draggable="true"
                    onDragStart={$onDragStart}
                    onDragEnd={$onDragEnd}
                    onClick={$handleCardClick}
                >
                    {$isEditing ? (
                        <input
                            type="text"
                            className="inline-edit-input"
                            value={$editTitle}
                            onChange={fn($e) => $setEditTitle($e->target->value)}
                            onKeyDown={function($e) use ($handleSaveEdit, $handleCancelEdit) {
                                if ($e->key === 'Enter') {
                                    $handleSaveEdit();
                                } elseif ($e->key === 'Escape') {
                                    $handleCancelEdit();
                                }
                            }}
                            onBlur={$handleSaveEdit}
                            data-testid="inline-edit-input"
                            autoFocus
                            onClick={fn($e) => $e->stopPropagation()}
                        />
                    ) : (
                        <div
                            className="card-title"
                            onClick={fn($e) => $e->stopPropagation()}
                            onDoubleClick={$handleTitleDoubleClick}
                        >
                            {$card['title']}
                        </div>
                    )}

                    <div className="card-meta">
                        <span className={"card-priority " . $getPriorityClass($card['priority'] ?? 'medium')}>
                            {$getPriorityLabel($card['priority'] ?? 'medium')}
                        </span>
                    </div>

                    <button
                        className="delete-card-btn"
                        onClick={$handleDeleteClick}
                        data-testid="delete-card-btn"
                        title="Delete card"
                    >
                        ×
                    </button>
            </div>

            {$showDeleteConfirm ? (
                <div className="confirm-dialog">
                    <div className="confirm-content">
                        <p>Are you sure you want to delete this card?</p>
                        <div className="form-actions">
                            <button
                                className="btn btn-secondary"
                                onClick={$handleCancelDelete}
                                data-testid="cancel-delete-btn"
                            >
                                Cancel
                            </button>
                            <button
                                className="btn btn-danger"
                                onClick={$handleConfirmDelete}
                                data-testid="confirm-delete-btn"
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            ) : null}

            {$isModalOpen ? (
                <div className="card-modal active" data-testid="card-modal">
                    <div className="modal-content">
                        <div className="modal-header">
                            <h2 data-testid="modal-card-title">{$card['title']}</h2>
                            <button
                                className="modal-close-btn"
                                onClick={fn() => $setIsModalOpen(false)}
                                data-testid="modal-close-btn"
                            >
                                ×
                            </button>
                        </div>

                        <div className="modal-body">
                            <div className="form-group">
                                <label>Priority</label>
                                <select
                                    value={$card['priority'] ?? 'medium'}
                                    onChange={fn($e) => $onUpdate(['priority' => $e->target->value])}
                                >
                                    <option value="low">Low</option>
                                    <option value="medium">Medium</option>
                                    <option value="high">High</option>
                                </select>
                            </div>

                            <div className="form-group">
                                <label>Description</label>
                                <textarea
                                    placeholder="Add a description..."
                                    value={$card['description'] ?? ''}
                                    onChange={fn($e) => $onUpdate(['description' => $e->target->value])}
                                />
                            </div>

                            <div className="form-group">
                                <label>Card ID</label>
                                <div className="card-id">{$card['id']}</div>
                            </div>
                        </div>

                        <div className="modal-footer">
                            <button
                                className="btn btn-danger"
                                onClick={$handleConfirmDelete}
                            >
                                Delete Card
                            </button>
                        </div>
                    </div>
                </div>
            ) : null}
        </div>
    );
}