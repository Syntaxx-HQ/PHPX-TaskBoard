declare(strict_types=1);

namespace TaskBoard;

use Syntaxx\PHPX\Framework\Component;
use Syntaxx\PHPX\Framework\Runtime;
use Syntaxx\PHPX\Framework\Document;
use TaskBoard\Components\Board;
use Vrzno;

// Main application entry point
function App() {
    return <Board />;
}

function createRoot($root) {
    return Runtime::createRoot($root);
}

// Load component files
require_once "Components/Board.php";
require_once "Components/Column.php";
require_once "Components/Card.php";

// Check if we're in WASM environment
if (class_exists('Vrzno')) {
    // Register the App component
    Runtime::registerComponent('App', 'TaskBoard\\App');

    // Using VRZNO to access JavaScript DOM
    $window = new Vrzno;
    $document = $window->document;
    $root = $document->getElementById("app");

    // Clear loading state
    $root->innerHTML = '';

    try {
        // Render the TaskBoard app
        createRoot($root)->render(<App />);

        // Signal success
        $window->console->log("TaskBoard Pro initialized successfully");

        // Set global flag
        $window->TaskBoard = [
            'initialized' => true,
            'version' => '1.0.0'
        ];
    } catch (\Exception $e) {
        $window->console->error("Error rendering TaskBoard: " . $e->getMessage());
    }
} else {
    // Server-side rendering (if needed)
    echo Component::render(<App />);
}<?php

