namespace Syntaxx\PHPX\Framework\VirtualDOM;

/**
 * Virtual Text Node
 *
 * Specialized VNode for text content
 */
class VText extends VNode {
    public function __construct(string $text) {
        parent::__construct('TEXT_NODE', ['textContent' => $text], [], null);
    }

    /**
     * Create text node from string
     */
    public static function create(string $text): self {
        return new self($text);
    }

    /**
     * Get text content
     */
    public function getText(): string {
        return $this->props['textContent'] ?? '';
    }

    /**
     * Update text content
     */
    public function setText(string $text): void {
        $this->props['textContent'] = $text;
    }
}
