        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $value = $input->value;
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $value = vrzno_eval("document.getElementById('test-input').value");
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'Property Read (value)', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 3: Property writes
        // ===================================
        $iterations = 10000;
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $input->value = "test{$i}";
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            vrzno_eval("document.getElementById('test-input').value = 'test{$i}'");
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'Property Write (value)', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 4: setAttribute
        // ===================================
        $iterations = 5000;
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $input->setAttribute('data-value', "test{$i}");
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            vrzno_eval("document.getElementById('test-input').setAttribute('data-value', 'test{$i}')");
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'setAttribute', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 5: classList operations
        // ===================================
        $iterations = 5000;
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $input->classList->add('active');
            $input->classList->remove('active');
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            vrzno_eval("const el = document.getElementById('test-input'); el.classList.add('active'); el.classList.remove('active');");
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'classList add/remove', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 6: Complex DOM traversal
        // ===================================
        $iterations = 1000;
        $container->innerHTML = '<div><div><div><span id="deep-span">text</span></div></div></div>';
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $span = $document->getElementById('deep-span');
            $parent = $span->parentElement;
            $grandparent = $parent->parentElement;
            $value = $span->textContent;
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            vrzno_eval(<<<JS
                            const span = document.getElementById('deep-span');
                            const parent = span.parentElement;
                            const grandparent = parent.parentElement;
                            const value = span.textContent;
            JS);
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'DOM Traversal', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 7: Multiple property updates
        // ===================================
        $iterations = 2000;
        // Re-create input element after previous test destroyed it
        $container->innerHTML = '<input id="test-input" value="test" />';
        $input = $document->getElementById('test-input');
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $input->value = "test{$i}";
            $input->className = "input-{$i}";
            $input->setAttribute('data-index', $i);
            $input->disabled = $i % 2 === 0;
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $disabled = $i % 2 === 0 ? 'true' : 'false';
            vrzno_eval(<<<JS
                            const el = document.getElementById('test-input');
                            el.value = 'test{$i}';
                            el.className = 'input-{$i}';
                            el.setAttribute('data-index', {$i});
                            el.disabled = {$disabled};
            JS);
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'Multiple Updates', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        $setResults($benchmarkResults);
        $setIsRunning(false);
    };
    return Component::create("div", ["style" => "padding: 20px; background: white; border-radius: 12px; max-width: 1200px; margin: 20px auto;"], [Component::create("h1", [], ["VRZNO Performance Benchmark"]), Component::create("p", [], ["Comparing direct VRZNO object access vs vrzno_eval()"]), Component::create("button", ["onClick" => $runBenchmark, "className" => "btn btn-primary", "style" => "margin: 20px 0; padding: 12px 24px; font-size: 16px; cursor: pointer;"], [$isRunning ? 'Running Benchmark...' : 'Run Benchmark']), !empty($results) ? Component::create("div", [], [Component::create("h2", [], ["Results"]), Component::create("table", ["style" => "width: 100%; border-collapse: collapse; margin-top: 20px;"], [Component::create("thead", [], [Component::create("tr", ["style" => "background: #f1f5f9; text-align: left;"], [Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["Test"]), Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["Iterations"]), Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["Direct VRZNO (ms)"]), Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["vrzno_eval (ms)"]), Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["Speedup"]), Component::create("th", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], ["Winner"])])]), Component::create("tbody", [], [array_map(fn($result) => Component::create("tr", ["key" => $result['test']], [Component::create("td", ["style" => "padding: 12px; border: 1px solid #cbd5e1; font-weight: 500;"], [$result['test']]), Component::create("td", ["style" => "padding: 12px; border: 1px solid #cbd5e1;"], [number_format($result['iterations'])]), Component::create("td", ["style" => "padding: 12px; border: 1px solid #cbd5e1; background: " . ($result['direct'] < $result['eval'] ? '#dcfce7' : '#fff')], [$result['direct'], " ms "]), Component::create("td", ["style