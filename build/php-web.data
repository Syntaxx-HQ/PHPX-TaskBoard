namespace Syntaxx\PHPX\Framework;

class Document {
    private static $instance = null;
    private $document;

    private function __construct() {
        $window = new \Vrzno;
        $this->document = $window->document;
    }

    public static function document(): self {
        if (self::$instance === null) {
            self::$instance = new self();
        }
        return self::$instance;
    }

    public function getElementById(string $id) {
        return $this->document->getElementById($id);
    }

    public function createElement(string $tagName) {
        return $this->document->createElement($tagName);
    }

    public function createTextNode(string $text) {
        return $this->document->createTextNode($text);
    }

    public function querySelector(string $selector) {
        return $this->document->querySelector($selector);
    }

    public function addEventListener(string $event, callable $listener) {
        $this->document->addEventListener($event, $listener);
    }

    public function querySelectorAll(string $selector) {
        return $this->document->querySelectorAll($selector);
    }
}
<?php

namespace Syntaxx\PHPX\Framework;

class Element {
    private $tagName;
    private $id;
    private $attributes = [];
    private $children = [];
    private $eventListeners = [];

    public function __construct(string $tagName, string $id) {
        $this->tagName = $tagName;
        $this->id = $id;
    }

    public function setAttribute(string $name, string $value): void {
        $this->attributes[$name] = $value;
    }

    public function addEventListener(string $event, callable $listener): void {
        if (!isset($this->eventListeners[$event])) {
            $this->eventListeners[$event] = [];
        }
        $this->eventListeners[$event][] = $listener;
    }

    public function appendChild($child): void {
        $this->children[] = $child;
    }

    public function toJavaScript(string $id): string {
        $js = "elements['{$id}'] = document.createElement('{$this->tagName}');\n";
        
        foreach ($this->attributes as $name => $value) {
            $js .= "elements['{$id}'].setAttribute('{$name}', '{$value}');\n";
        }

        foreach ($this->eventListeners as $event => $listeners) {
            foreach ($listeners as $index => $listener) {
                $js .= "elements['{$id}'].addEventListener('{$event}', function(e) {\n";
                $js .= "    // Call PHP event handler\n";
                $js .= "    fetch('/php-handler', {\n";
                $js .= "        method: 'POST',\n";
                $js .= "        body: JSON.stringify({\n";
                $js .= "            elementId: '{$id}',\n";
                $js .= "            event: '{$event}',\n";
                $js .= "            listenerIndex: {$index}\n";
                $js .= "        })\n";
                $js .= "    });\n";
                $js .= "});\n";
            }
        }

        foreach ($this->children as $child) {
            if ($child instanceof Element) {
                $js .= $child->toJavaScript($child->id) . "\n";
                $js .= "elements['{$id}'].appendChild(elements['{$child->id}']);\n";
            } elseif ($child instanceof TextNode) {
                $js .= "elements['{$id}'].appendChild(document.createTextNode('" . 
                    addslashes($child->getText()) . "'));\n";
            }
        }

        return $js;
    }
} <?php
namespace Syntaxx\PHPX\Framework\Fiber;

use Syntaxx\PHPX\Framework\VirtualDOM\VNode;

/**
 * Fiber Node - Unit of work in reconciliation
 *
 * Based on React Fiber architecture.
 * Each FiberNode represents one element/component in the tree.
 *
 * The fiber tree uses a linked-list structure for efficient traversal:
 * - return: parent fiber
 * - child: first child
 * - sibling: next sibling
 */
class FiberNode {
    // === Tree Structure (linked list) ===
    public ?FiberNode $return = null;      // Parent fiber
    public ?FiberNode $child = null;       // First child
    public ?FiberNode $sibling = null;     // Next sibling

    // === Work ===
    public string $type;                   // Element type (div, MyComponent, etc)
    public ?string $key = null;            // Reconciliation key
    public ?VNode $pendingProps = null;    // New props (from render)
    public ?VNode $memoizedProps = null;   // Current props (committed)
    public mixed $memoizedState = null;    // Component state
    public ?array $updateQueue = null;     // Pending state updates

    // === Effects (what work needs to be done) ===
    public int $effectTag = 0;             // Bit flags for work type
    public ?FiberNode $nextEffect = null;  // Next effect in list
    public ?FiberNode $firstEffect = null; // First child effect
    public ?FiberNode $lastEffect = null;  // Last child effect

    // === DOM ===
    public ?object $stateNode = null;      // VRZNO DOM element reference (CRITICAL!)
    public ?FiberNode $alternate = null;   // Previous fiber (double buffering)

    // === Priority ===
    public int $expirationTime = 0;        // When this work expires
    public int $childExpirationTime = 0;   // When children work expires

    // === Hooks ===
    public ?array $hooks = null;           // Hook state for function components
    public int $hookIndex = 0;             // Current hook index during render

    // Effect tag constants (bit flags)
    const NO_EFFECT = 0;
    const PLACEMENT = 1;      // Insert node
    const UPDATE = 2;         // Update properties
    const DELETION = 4;       // Remove node
    const CONTENT_RESET = 8;  // Reset text content
    const CALLBACK = 16;      // Callback after commit
    const REF = 32;           // Update ref
    const SNAPSHOT = 64;      // Get snapshot before mutation

    public function __construct(
        string $type,
        ?VNode $pendingProps = null,
        ?string $key = null
    ) {
        $this->type = $type;
        $this->pendingProps = $pendingProps;
        $this->key = $key;
    }

    /**
     * Check if this fiber has any work to do
     */
    public function hasEffect(): bool {
        return $this->effectTag !== self::NO_EFFECT;
    }

    /**
     * Check if specific effect tag is set
     */
    public function hasEffectTag(int $tag): bool {
        return ($this->effectTag & $tag) === $tag;
    }

    /**
     * Add effect tag (bitwise OR)
     */
    public function addEffectTag(int $tag): void {
        $this->effectTag |= $tag;
    }

    /**
     * Remove effect tag (bitwise AND NOT)
     */
    public function removeEffectTag(int $tag): void {
        $this->effectTag &= ~$tag;
    }

    /**
     * Clear all effect tags
     */
    public function clearEffectTags(): void {
        $this->effectTag = self::NO_EFFECT;
    }

    /**
     * Append effect to effect list
     */
    public function appendEffect(FiberNode $effect): void {
        if ($this->lastEffect === null) {
            $this->firstEffect = $effect;
            $this->lastEffect = $effect;
        } else {
            $this->lastEffect->nextEffect = $effect;
            $this->lastEffect = $effect;
        }
    }

    /**
     * Append all child effects to this fiber's effect list
     */
    public function appendAllChildEffects(): void {
        // Traverse children and collect their effects
        $child = $this->child;
        while ($child !== null) {
            if ($child->hasEffect() || $child->firstEffect !== null) {
                // Append child's effect list
                if ($child->firstEffect !== null) {
                    if ($this->lastEffect === null) {
                        $this->firstEffect = $child->firstEffect;
                        $this->lastEffect = $child->lastEffect;
                    } else {
                        $this->lastEffect->nextEffect = $child->firstEffect;
                        $this->lastEffect = $child->lastEffect;
                    }
                }

                // Append child itself if it has work
                if ($child->hasEffect()) {
                    $this->appendEffect($child);
                }
            }

            $child = $child->sibling;
        }
    }

    /**
     * Create alternate fiber (for double buffering)
     */
    public function createAlternate(): FiberNode {
        $alternate = new FiberNode($this->type, $this->pendingProps, $this->key);
        $alternate->alternate = $this;
        $alternate->stateNode = $this->stateNode; // Reuse DOM node!
        $alternate->memoizedState = $this->memoizedState;
        $alternate->hooks = $this->hooks;

        return $alternate;
    }

    /**
     * Get string representation (for debugging)
     */
    public function __toString(): string {
        $effects = [];
        if ($this->hasEffectTag(self::PLACEMENT)) $effects[] = 'PLACEMENT';
        if ($this->hasEffectTag(self::UPDATE)) $effects[] = 'UPDATE';
        if ($this->hasEffectTag(self::DELETION)) $effects[] = 'DELETION';

        $effectStr = empty($effects) ? 'NO_EFFECT' : implode('|', $effects);
        $keyStr = $this->key ? "[key:{$this->key}]" : '';

        return "Fiber({$this->type}{$keyStr}, {$effectStr})";
    }
}
<?php
namespace Syntaxx\PHPX\Framework\Fiber;

/**
 * Fiber Root - Root of the fiber tree
 *
 * Manages double buffering:
 * - current: Tree currently displayed
 * - finishedWork: Tree being built (work-in-progress)
 *
 * After reconciliation completes, we atomically swap current <-> finishedWork
 */
class FiberRoot {
    public object $containerElement;       // VRZNO DOM element (root container)
    public ?FiberNode $current = null;     // Current committed tree
    public ?FiberNode $finishedWork = null; // Completed work-in-progress tree

    // Expiration tracking
    public int $pendingExpirationTime = 0;
    public int $finishedExpirationTime = 0;

    // Callback tracking
    public ?callable $onCommit = null;     // Called after commit

    // Performance tracking
    public float $lastCommitTime = 0.0;
    public int $commitCount = 0;

    public function __construct(object $containerElement) {
        $this->containerElement = $containerElement;

        // Create initial root fiber
        $this->current = new FiberNode('ROOT', null, null);
        $this->current->stateNode = $containerElement;
    }

    /**
     * Schedule an update with expiration time
     */
    public function scheduleUpdate(int $expirationTime): void {
        if ($expirationTime > $this->pendingExpirationTime) {
            $this->pendingExpirationTime = $expirationTime;
        }
    }

    /**
     * Mark work as finished
     */
    public function finishWork(FiberNode $finishedWork, int $expirationTime): void {
        $this->finishedWork = $finishedWork;
        $this->finishedExpirationTime = $expirationTime;
    }

    /**
     * Commit finished work (swap trees)
     */
    public function commit(): void {
        if ($this->finishedWork === null) {
            return;
        }

        // Swap current <-> finishedWork (double buffering)
        $this->current = $this->finishedWork;
        $this->finishedWork = null;

        // Track commit
        $this->lastCommitTime = microtime(true);
        $this->commitCount++;

        // Call commit callback if set
        if ($this->onCommit) {
            call_user_func($this->onCommit);
        }
    }

    /**
     * Check if there's pending work
     */
    public function hasPendingWork(): bool {
        return $this->pendingExpirationTime > 0;
    }

    /**
     * Reset pending expiration time
     */
    public function resetPendingTime(): void {
        $this->pendingExpirationTime = 0;
    }

    /**
     * Get time since last commit (in milliseconds)
     */
    public function getTimeSinceLastCommit(): float {
        return (microtime(true) - $this->lastCommitTime) * 1000;
    }
}
