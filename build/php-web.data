namespace Syntaxx\PHPX\Framework;

class Framework
{
    private static array $states = [];
    private static int $stateIndex = 0;
    private static array $components = [];

    public static function useState($initialValue): array
    {
        $currentIndex = self::$stateIndex;
        
        if (!isset(self::$states[$currentIndex])) {
            self::$states[$currentIndex] = $initialValue;
        }

        $state = self::$states[$currentIndex];
        $setState = function($newValue) use ($currentIndex) {
            self::$states[$currentIndex] = $newValue;
            self::render();
        };

        self::$stateIndex++;
        return [$state, $setState];
    }

    public static function registerComponent(string $name, callable $component): void
    {
        if (isset(self::$components[$name])) {
            throw new \RuntimeException("Component {$name} is already registered");
        }
        self::$components[$name] = $component;
    }

    public static function renderComponent(string $name, array $props = []): string
    {
        if (!isset(self::$components[$name])) {
            throw new \RuntimeException("Component {$name} not found. Did you forget to register it?");
        }

        try {
            $component = self::$components[$name];
            return $component($props);
        } catch (\Exception $e) {
            error_log("Error rendering component {$name}: " . $e->getMessage());
            return "<div class='error'>Error rendering component {$name}</div>";
        }
    }

    public static function render(): void
    {
        if (!isset(self::$components['App'])) {
            throw new \RuntimeException("App component not found. Please register an App component.");
        }

        self::$stateIndex = 0;
        try {
            $output = self::renderComponent('App');
            echo $output;
        } catch (\Exception $e) {
            error_log("Error during render: " . $e->getMessage());
            echo "<div class='error'>Error during render</div>";
        }
    }

    public static function init(): void
    {
        try {
            // Register VRZNO event handlers
            echo '<script src="https://vrzno.js"></script>';
            echo '<script>
                window.vrzno = new VRZNO();
                window.vrzno.on("event", function(event) {
                    try {
                        // Handle events from PHP components
                        console.log("Event received:", event);
                    } catch (e) {
                        console.error("Error handling event:", e);
                    }
                });
            </script>';
        } catch (\Exception $e) {
            error_log("Error during framework initialization: " . $e->getMessage());
        }
    }
} <?php
namespace Syntaxx\PHPX\Framework\Reconciler;

use Syntaxx\PHPX\Framework\Core\VrznoContext;
use Syntaxx\PHPX\Framework\VirtualDOM\VNode;
use Syntaxx\PHPX\Framework\DOM\DOMPropertyOperations;
use Syntaxx\PHPX\Framework\DOM\DOMChildrenOperations;
use Syntaxx\PHPX\Framework\Commit\FocusManager;

/**
 * Simple Reconciler (MVP Version)
 *
 * This is a simplified reconciler that solves the immediate focus problem.
 * It performs basic Virtual DOM diffing and updates DOM efficiently.
 *
 * Future: Replace with full Fiber reconciler for concurrent rendering.
 */
class SimpleReconciler {
    private static array $domNodeCache = [];

    /**
     * Reconcile VNode tree with DOM
     *
     * This is the main entry point for rendering
     */
    public static function reconcile(object $container, VNode $newVNode, ?VNode $oldVNode = null): void {
        echo "ðŸŸ¢ SimpleReconciler::reconcile START";
        echo "ðŸŸ¢ New VNode type: " . $newVNode->type;

        // Save focus BEFORE any DOM changes
        FocusManager::saveFocusState();

        // Perform reconciliation
        if ($oldVNode === null) {
            echo "ðŸŸ¢ Initial mount - creating everything";
            // Initial mount - create everything
            $domNode = self::mount($newVNode);
            echo "ðŸŸ¢ Mounted, clearing container...";
            DOMChildrenOperations::removeAllChildren($container);
            echo "ðŸŸ¢ Appending to container...";
            DOMChildrenOperations::appendChild($container, $domNode);
            echo "ðŸŸ¢ Append complete!";
        } else {
            echo "ðŸŸ¢ Update - diffing";
            // Update - diff and patch
            $containerFirstChild = self::getFirstChild($container);
            if ($containerFirstChild) {
                self::diff($containerFirstChild, $newVNode, $oldVNode);
            } else {
                echo "ðŸŸ¢ No first child, mounting fresh";
                $domNode = self::mount($newVNode);
                DOMChildrenOperations::appendChild($container, $domNode);
            }
        }

        // Restore focus AFTER all DOM changes
        FocusManager::restoreFocusState();

        echo "âœ… SimpleReconciler::reconcile COMPLETE";
    }

    /**
     * Mount new VNode (create DOM from scratch)
     */
    private static function mount(VNode $vnode): object {
        if ($vnode->isTextNode()) {
            return VrznoContext::createTextNode($vnode->props['textContent'] ?? '');
        }

        $element = VrznoContext::createElement($vnode->type);

        // Handle event handlers (onClick, onChange, etc.)
        $eventHandlers = [];
        foreach ($vnode->props as $key => $value) {
            if (str_starts_with($key, 'on') && is_callable($value)) {
                $eventHandlers[$key] = $value;
                echo "ðŸ”¸ Found event handler: {$key} on {$vnode->type}";
            }
        }

        // Bind event handlers using property assignment (onclick, onchange, etc.)
        // CRITICAL: VRZNO's addEventListener() doesn't work with PHP closures!
        // Use direct property assignment instead: $element->onclick = fn() => ...
        if (!empty($eventHandlers)) {
            echo "ðŸ”¸ Binding " . count($eventHandlers) . " handlers via property assignment";

            foreach ($eventHandlers as $key => $handler) {
                // Map JSX event names to DOM property names
                // CRITICAL: onDoubleClick must map to ondblclick (NOT ondoubleclick)!
                $eventProperty = strtolower($key); // onClick -> onclick
                if ($eventProperty === 'ondoubleclick') {
                    $eventProperty = 'ondblclick'; // Fix for double-click events
                }

                echo "ðŸ”¸ Setting {$eventProperty} property on {$vnode->type}";

                // DEBUG: Check element type
                var_dump("DEBUG: element->tagName = " . ($element->tagName ?? 'UNKNOWN'));
                var_dump("DEBUG: eventProperty = {$eventProperty}");
                var_dump("DEBUG: handler type = " . gettype($handler));

                // CRITICAL: Direct property assignment (like Tic-Tac-Toe example)
                // Wrap handler to trigger re-render
                $element->$eventProperty = function($event) use ($handler, $eventProperty) {
                    echo "ðŸ”¥ Event fired via property: {$eventProperty}";
                    var_dump("DEBUG: Inside handler, event type = " . gettype($event));
                    try {
                        // Execute original handler
                        $handler($event);

                        // Trigger re-render
                        if (isset($GLOBALS['__PHPX_ROOT__'])) {
                            echo "ðŸ”¥ Triggering re-render...";
                            $GLOBALS['__PHPX_ROOT__']->render($GLOBALS['__PHPX_COMPONENT__']);
                        }
                    } catch (\Exception $e) {
                        echo "âŒ Error executing handler: " . $e->getMessage();
                        var_dump("DEBUG: Exception details", $e);
                    }
                };

                // DEBUG: Verify it was set
                var_dump("DEBUG: After assignment, element->{$eventProperty} type = " . gettype($element->$eventProperty));
            }
        }

        // Set properties (excluding event handlers)
        $props = array_filter(
            $vnode->props,
            fn($key) => $key !== 'children' && $key !== 'key',
            ARRAY_FILTER_USE_KEY
        );
        DOMPropertyOperations::setAllProperties($element, $props);

        // Mount children
        foreach ($vnode->children as $child) {
            $childDom = self::mount($child);
            DOMChildrenOperations::appendChild($element, $childDom);
        }

        return $element;
    }

    /**
     * Diff old and new VNode, update DOM accordingly
     *
     * CRITICAL: This preserves DOM nodes when type/key match!
     */
    private static function diff(object $domNode, VNode $newVNode, VNode $oldVNode): void {
        // Check if node type changed
        if ($newVNode->type !== $oldVNode->type) {
            // Type changed - replace entire node
            $newDomNode = self::mount($newVNode);
            self::replaceNode($domNode, $newDomNode);
            return;
        }

        // Same type - update properties
        if ($newVNode->isTextNode()) {
            // Text node - update content if changed
            $newText = $newVNode->props['textContent'] ?? '';
            $oldText = $oldVNode->props['textContent'] ?? '';

            if ($newText !== $oldText) {
                $domNode->textContent = $newText;
            }
        } else {
            // Element node - update properties
            $oldProps = $oldVNode->props;
            $newProps = $newVNode->props;

            // Update event handlers via property assignment
            foreach ($newProps as $key => $value) {
                if (str_starts_with($key, 'on') && is_callable($value)) {
                    // Map JSX event names to DOM property names
                    // CRITICAL: onDoubleClick must map to ondblclick (NOT ondoubleclick)!
                    $eventProperty = strtolower($key); // onClick -> onclick
                    if ($eventProperty === 'ondoubleclick') {
                        $eventProperty = 'ondblclick'; // Fix for double-click events
                    }

                    echo "ðŸ”„ Updating event handler: {$eventProperty}";

                    // Update property directly
                    $domNode->$eventProperty = function($event) use ($value, $eventProperty) {
                        echo "ðŸ”¥ Event fired via property: {$eventProperty}";
                        try {
                            $value($event);
                            if (isset($GLOBALS['__PHPX_ROOT__'])) {
                                $GLOBALS['__PHPX_ROOT__']->render($GLOBALS['__PHPX_COMPONENT__']);
                            }
                        } catch (\Exception $e) {
                            echo "âŒ Error executing handler: " . $e->getMessage();
                        }
                    };
                }
            }

            DOMPropertyOperations::updateProperties($domNode, $oldProps, $newProps);

            // Diff children
            self::diffChildren($domNode, $newVNode->children, $oldVNode->children);
        }
    }

    /**
     * Diff children arrays
     */
    private static function diffChildren(object $parentDom, array $newChildren, array $oldChildren): void {
        $newCount = count($newChildren);
        $oldCount = count($oldChildren);
        $maxCount = max($newCount, $oldCount);

        // Get current DOM children
        $domChildren = self::getDOMChildren($parentDom);

        for ($i = 0; $i < $maxCount; $i++) {
            $newChild = $newChildren[$i] ?? null;
            $oldChild = $oldChildren[$i] ?? null;
            $domChild = $domChildren[$i] ?? null;

            if ($newChild && $oldChild) {
                // Both exist - diff them
                if ($domChild) {
                    self::diff($domChild, $newChild, $oldChild);
                } else {
                    // Should not happen, but handle gracefully
                    $newDomNode = self::mount($newChild);
                    DOMChildrenOperations::appendChild($parentDom, $newDomNode);
                }
            } else if ($newChild && !$oldChild) {
                // New child added
                $newDomNode = self::mount($newChild);
                DOMChildrenOperations::appendChild($parentDom, $newDomNode);
            } else if (!$newChild && $oldChild) {
                // Old child removed
                if ($domChild) {
                    DOMChildrenOperations::removeChild($parentDom, $domChild);
                }
            }
        }
    }

    /**
     * Replace DOM node
     */
    private static function replaceNode(object $oldNode, object $newNode): void {
        $parent = $oldNode->parentNode ?? null;
        if ($parent) {
            DOMChildrenOperations::replaceChild($parent, $newNode, $oldNode);
        }
    }

    /**
     * Get DOM children as array
     */
    private static function getDOMChildren(object $parentDom): array {
        $children = [];
        $childNodes = $parentDom->childNodes ?? null;

        if ($childNodes && property_exists($childNodes, 'length')) {
            for ($i = 0; $i < $childNodes->length; $i++) {
                $children[] = $childNodes->item($i);
            }
        }

        return $children;
    }

    /**
     * Get first child of DOM node
     */
    private static function getFirstChild(object $domNode): ?object {
        return $domNode->firstChild ?? null;
    }
}
<?php

namespace Syntaxx\PHPX\Framework;

class Runtime
{
    private $rootElement;
    private static $stateHooks = [];
    private static $hookIndex = 0;
    private static $currentRoot = null;
    private static $currentComponent = null;
    private static $componentRegistry = [];
    private static $componentStates = [];
    private static $currentComponentId = null;
    private static $currentComponentFunction = null;
    private static $handlerMappings = [];

    public static function createRoot($element): self
    {
        // Initialize VRZNO context
        \Syntaxx\PHPX\Framework\Core\VrznoContext::initialize();

        self::$currentRoot = new self($element);
        $GLOBALS['__PHPX_ROOT__'] = self::$currentRoot;
        return self::$currentRoot;
    }

    private function __construct($element)
    {
        $this->rootElement = $element;
    }

    private static $previousVNode = null;

    public function render($component)
    {
        self::$currentComponent = $component;
        $GLOBALS['__PHPX_COMPONENT__'] = $component;
        self::$hookIndex = 0; // Reset hook index for new render
        self::$currentComponentId = spl_object_hash($component);

        echo "ðŸ”µ RENDER START - Component type: " . (is_object($component) ? get_class($component) : gettype($component));

        // FULL VIRTUAL DOM RENDERING
        try {
            echo "ðŸ”µ Building VNode tree...";

            // Build VNode tree from component
            $newVNode = \Syntaxx\PHPX\Framework\VirtualDOM\VNodeBuilder::build($component);

            echo "ðŸ”µ VNode built: type=" . $newVNode->type . ", children=" . count($newVNode->children);

            echo "ðŸ”µ Starting reconciliation...";

            // Reconcile with previous VNode using Virtual DOM
            \Syntaxx\PHPX\Framework\Reconciler\SimpleReconciler::reconcile(
                $this->rootElement,
                $newVNode,
                self::$previousVNode
            );

            echo "ðŸ”µ Reconciliation complete!";

            // Store for next render
            self::$previousVNode = $newVNode;

            echo "âœ… RENDER COMPLETE - Virtual DOM SUCCESS!";
        } catch (\Exception $e) {
            echo "âŒ Virtual DOM ERROR: " . $e->getMessage();
            echo "âŒ Stack trace: " . $e->getTraceAsString();
            throw $e; // Re-throw to see in console
        }
    }

    private function bindEventHandlers()
    {
        // Find all elements with data-handler-id
        $nodeList = Document::document()->querySelectorAll('[data-handler-id]');

        // Get the length of the NodeList
        $length = $nodeList->length;

        // Iterate through the NodeList
        for ($i = 0; $i < $length; $i++) {
            $element = $nodeList->item($i);
            $handlerId = $element->getAttribute('data-handler-id');
            $self = $this;

            // Get the handler mapping to determine event type
            if (isset(self::$handlerMappings[$handlerId])) {
                $mapping = self::$handlerMappings[$handlerId];
                $eventType = $mapping['eventType'] ?? 'click';

                // Create a new event handler that will be recreated on each render
                $element->addEventListener($eventType, function($event) use ($handlerId, $self) {
                    // Get the handler mapping
                    if (isset(self::$handlerMappings[$handlerId])) {
                        $mapping = self::$handlerMappings[$handlerId];
                        $handler = $mapping['handler'];

                        try {
                            // Execute the handler with the event object
                            $handler($event);
                            // Force a re-render
                            if (isset($GLOBALS['__PHPX_ROOT__'])) {
                                $GLOBALS['__PHPX_ROOT__']->render($GLOBALS['__PHPX_COMPONENT__']);
                            }
                        } catch (\Exception $e) {
                            var_dump("Error executing handler:", $e->getMessage());
                        }
                    }
                });
            }
        }
    }

    private function renderComponentToString($component): string
    {
        if (is_string($component)) {
            return htmlspecialchars($component);
        }

        if ($component instanceof Component) {
            // Debug: Log the component being processed
            //var_dump("Processing component:", $component->type);
            //var_dump("Component props:", $component->props);
            
            // Check if this is a custom component
            $componentName = $component->type;
            
            // First check in component registry
            if (isset(self::$componentRegistry[$componentName])) {
                // Store the current component function
                self::$currentComponentFunction = self::$componentRegistry[$componentName];
                //var_dump("Found component in registry:", $componentName);
                
                // It's a registered component, call it with props including children
                $propsWithChildren = $component->props;
                $propsWithChildren['children'] = $component->children;
                $nestedComponent = self::$componentRegistry[$componentName]($propsWithChildren);
                // Clear the current component function
                self::$currentComponentFunction = null;
                // Debug: Log the result of component function
                //var_dump("Component function result:", $nestedComponent);
                return $this->renderComponentToString($nestedComponent);
            }
            
            // Then check in App namespace
            $appComponentName = "\\Syntaxx\\PHPX\\Demo\\{$componentName}";
            if (function_exists($appComponentName)) {
                // Store the current component function
                self::$currentComponentFunction = $appComponentName;
                //var_dump("Found component in App namespace:", $appComponentName);
                
                // Make useState available in the component's namespace
                if (!function_exists("\\Syntaxx\\PHPX\\Demo\\useState")) {
                    eval('namespace Syntaxx\\PHPX\\Demo; function useState($initialValue) { return \\Syntaxx\\PHPX\\Framework\\Runtime::useState($initialValue); }');
                }
                
                // It's a function component, call it with props including children
                $propsWithChildren = $component->props;
                $propsWithChildren['children'] = $component->children;
                $nestedComponent = $appComponentName($propsWithChildren);
                // Clear the current component function
                self::$currentComponentFunction = null;
                // Debug: Log the result of component function
                //var_dump("Component function result:", $nestedComponent);
                return $this->renderComponentToString($nestedComponent);
            }
            
            // Check if function exists in global namespace (but skip HTML elements)
            $htmlElements = ['header', 'footer', 'main', 'nav', 'section', 'article', 'aside', 'time', 
                           'button', 'input', 'form', 'div', 'span', 'a', 'p', 'h1', 'h2', 'h3', 
                           'h4', 'h5', 'h6', 'ul', 'ol', 'li', 'table', 'tr', 'td', 'th', 'img',
                           'video', 'audio', 'canvas', 'svg', 'path', 'g', 'circle', 'rect'];
            if (function_exists($componentName) && !in_array(strtolower($componentName), $htmlElements)) {
                // Store the current component function
                self::$currentComponentFunction = $componentName;
                
                // It's a function component, call it with props including children
                $propsWithChildren = $component->props;
                $propsWithChildren['children'] = $component->children;
                $nestedComponent = $componentName($propsWithChildren);
                // Clear the current component function
                self::$currentComponentFunction = null;
                return $this->renderComponentToString($nestedComponent);
            }
            
            // Before treating as HTML element, check if the component name starts with uppercase
            if (ctype_upper($componentName[0]) && !in_array(strtolower($componentName), $htmlElements)) {
                // Component not found but looks like it should be a component
            }

            // Regular HTML element
            $attributes = '';
            $eventHandlers = [];
            foreach ($component->props as $key => $value) {
                if (strpos($key, 'on') === 0) {
                    // Store event handlers for later binding
                    $eventHandlers[$key] = $value;
                    // Generate a unique ID for the element
                    $handlerId = uniqid('handler_');
                    //var_dump("Generated handler ID:", $handlerId, "for {$key} handler:", $value);
                    // Store the handler mapping with event type
                    $eventType = strtolower(substr($key, 2)); // onClick -> click, onChange -> change
                    self::$handlerMappings[$handlerId] = [
                        'handler' => $value,
                        'props' => $component->props,
                        'eventType' => $eventType
                    ];
                    $attributes .= " data-handler-id=\"{$handlerId}\" data-event-{$eventType}=\"{$handlerId}\"";
                } else {
                    // Convert className to class for HTML
                    $attrName = $key === 'className' ? 'class' : $key;
                    $attributes .= " {$attrName}=\"{$value}\"";
                }
            }

            $childrenHtml = '';
            foreach ($component->children as $child) {
                if ($child instanceof Component) {
                    // Don't propagate props to child components - each component should have its own props
                    $childrenHtml .= $this->renderComponentToString($child);
                } elseif (is_array($child)) {
                    // Handle array of children (e.g., from array_map)
                    foreach ($child as $nestedChild) {
                        if ($nestedChild instanceof Component) {
                            $childrenHtml .= $this->renderComponentToString($nestedChild);
                        } else {
                            $childrenHtml .= htmlspecialchars((string)$nestedChild);
                        }
                    }
                } else {
                    $childrenHtml .= htmlspecialchars((string)$child);
                }
            }

            return "<{$component->type}{$attributes}>{$childrenHtml}</{$component->type}>";
        }

        return '';
    }

    public static function getCurrentComponentFunction()
    {
        return self::$currentComponentFunction;
    }

    public static function setCurrentComponentFunction($function)
    {
        self::$currentComponentFunction = $function;
    }

    public static function registerEventHandler(string $handlerId, array $mapping): void
    {
        self::$handlerMappings[$handlerId] = $mapping;
    }

    public static function registerComponent(string $name, callable $component): void
    {
        self::$componentRegistry[$name] = $component;
    }

    public static function useState($initialValue)
    {
        $componentFunction = self::getCurrentComponentFunction();
        if (!$componentFunction) {
            throw new \RuntimeException("useState must be called within a component");
        }

        // Initialize component state if not exists
        if (!isset(self::$componentStates[$componentFunction])) {
            self::$componentStates[$componentFunction] = [];
        }

        $index = self::$hookIndex;
        
        // Initialize state if not exists
        if (!isset(self::$componentStates[$componentFunction][$index])) {
            self::$componentStates[$componentFunction][$index] = $initialValue;
        }

        $value = self::$componentStates[$componentFunction][$index];
        
        // Create setState function
        $setValue = function($newValue) use ($componentFunction, $index) {
            var_dump("ðŸŸ£ useState setValue called, index={$index}");

            // If newValue is a function, call it with current state
            if (is_callable($newValue)) {
                $newValue = $newValue(self::$componentStates[$componentFunction][$index]);
            }

            // Update state
            self::$componentStates[$componentFunction][$index] = $newValue;
            var_dump("ðŸŸ£ State updated, __PHPX_ROOT__ isset = " . (isset($GLOBALS['__PHPX_ROOT__']) ? 'YES' : 'NO'));

            // Trigger re-render
            if (isset($GLOBALS['__PHPX_ROOT__'])) {
                var_dump("ðŸŸ£ Calling render...");
                $GLOBALS['__PHPX_ROOT__']->render($GLOBALS['__PHPX_COMPONENT__']);
            } else {
                var_dump("ðŸŸ£ WARNING: __PHPX_ROOT__ not set!");
            }
        };

        self::$hookIndex++;
        return [$value, $setValue];
    }

    public static function handleStateUpdate($index, $value)
    {
        if (!isset(self::$stateHooks[$index])) {
            throw new \RuntimeException("State hook at index {$index} does not exist");
        }
        
        self::$stateHooks[$index] = $value;
        
        if (self::$currentRoot && self::$currentComponent) {
            self::$currentRoot->render(self::$currentComponent);
        }
    }
}
