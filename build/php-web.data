namespace Syntaxx\PHPX\Framework\Commit;

use Syntaxx\PHPX\Framework\Core\VrznoContext;

/**
 * Focus Manager (VRZNO-native)
 *
 * CRITICAL: This solves the input focus loss issue!
 *
 * Saves focus state before DOM mutations and restores after,
 * ensuring users don't lose their place when typing.
 */
class FocusManager {
    private static array $focusState = [];

    /**
     * Save current focus state before DOM mutations
     *
     * MUST be called BEFORE any DOM changes!
     */
    public static function saveFocusState(): void {
        $document = VrznoContext::getDocument();
        $activeElement = $document->activeElement;

        // Only save if it's an input/textarea/select
        if (!$activeElement) {
            self::$focusState = [];
            return;
        }

        $tagName = $activeElement->tagName ?? '';
        if ($tagName !== 'INPUT' && $tagName !== 'TEXTAREA' && $tagName !== 'SELECT') {
            self::$focusState = [];
            return;
        }

        // Save comprehensive focus state
        self::$focusState = [
            'element' => $activeElement,  // VRZNO reference
            'id' => $activeElement->id ?? null,
            'testId' => self::getAttributeSafe($activeElement, 'data-testid'),
            'name' => $activeElement->name ?? null,
            'tagName' => $tagName,
            'type' => $activeElement->type ?? null,
            'value' => $activeElement->value ?? '',
            'selectionStart' => self::getSelectionStart($activeElement),
            'selectionEnd' => self::getSelectionEnd($activeElement),
            'selectionDirection' => self::getSelectionDirection($activeElement),
            'scrollTop' => $activeElement->scrollTop ?? 0,
            'scrollLeft' => $activeElement->scrollLeft ?? 0,
        ];
    }

    /**
     * Restore focus state after DOM mutations
     *
     * MUST be called AFTER all DOM changes!
     */
    public static function restoreFocusState(): void {
        if (empty(self::$focusState)) {
            return;
        }

        $state = self::$focusState;
        $document = VrznoContext::getDocument();

        // Try multiple strategies to find the element
        $element = null;

        // Strategy 1: By ID (most reliable)
        if ($state['id']) {
            $element = $document->getElementById($state['id']);
        }

        // Strategy 2: By data-testid
        if (!$element && $state['testId']) {
            $element = $document->querySelector("[data-testid='{$state['testId']}']");
        }

        // Strategy 3: By name
        if (!$element && $state['name']) {
            $elements = $document->querySelectorAll("[name='{$state['name']}']");
            if ($elements && property_exists($elements, 'length') && $elements->length > 0) {
                $element = $elements->item(0);
            }
        }

        // Verify element type matches (safety check)
        if ($element) {
            $matchesType = ($element->tagName ?? '') === $state['tagName'];
            $matchesInputType = !isset($state['type']) ||
                                ($element->type ?? null) === $state['type'];

            if ($matchesType && $matchesInputType) {
                // Restore focus
                try {
                    $element->focus();
                } catch (\Exception $e) {
                    // Element might not be focusable
                }

                // Restore selection range (if supported)
                if ($state['tagName'] === 'INPUT' || $state['tagName'] === 'TEXTAREA') {
                    try {
                        if (method_exists($element, 'setSelectionRange')) {
                            $element->setSelectionRange(
                                $state['selectionStart'],
                                $state['selectionEnd'],
                                $state['selectionDirection']
                            );
                        }
                    } catch (\Exception $e) {
                        // Some input types don't support selection (email, number, etc)
                    }
                }

                // Restore scroll position
                try {
                    $element->scrollTop = $state['scrollTop'];
                    $element->scrollLeft = $state['scrollLeft'];
                } catch (\Exception $e) {
                    // Scroll might not be supported
                }
            }
        }

        // Clear state
        self::$focusState = [];
    }

    /**
     * Check if we have saved focus state
     */
    public static function hasFocusState(): bool {
        return !empty(self::$focusState);
    }

    /**
     * Get saved focus element ID (for debugging)
     */
    public static function getFocusedElementId(): ?string {
        return self::$focusState['id'] ?? self::$focusState['testId'] ?? self::$focusState['name'] ?? null;
    }

    // === Helper Methods ===

    private static function getAttributeSafe(object $element, string $attr): ?string {
        try {
            $value = $element->getAttribute($attr);
            return $value !== null && $value !== false ? (string)$value : null;
        } catch (\Exception $e) {
            return null;
        }
    }

    private static function getSelectionStart(object $element): int {
        try {
            return $element->selectionStart ?? 0;
        } catch (\Exception $e) {
            return 0;
        }
    }

    private static function getSelectionEnd(object $element): int {
        try {
            return $element->selectionEnd ?? 0;
        } catch (\Exception $e) {
            return 0;
        }
    }

    private static function getSelectionDirection(object $element): string {
        try {
            return $element->selectionDirection ?? 'none';
        } catch (\Exception $e) {
            return 'none';
        }
    }
}
<?php

namespace Syntaxx\PHPX\Framework;

class Component
{
    public $type;
    public $props;
    public $children;

    public function __construct(string $type, array $props = [], array $children = [])
    {
        $this->type = $type;
        $this->props = $props;
        $this->children = $children;
    }

    public static function create(string $type, array $props = [], array $children = []): self
    {
        return new self($type, $props, $children);
    }

    public function render(): string
    {
        $attributes = '';
        foreach ($this->props as $key => $value) {
            if (strpos($key, 'on') === 0) {
                // For event handlers, we'll handle them in Runtime
                continue;
            }
            $attributes .= " {$key}=\"{$value}\"";
        }

        $childrenHtml = '';
        foreach ($this->children as $child) {
            if ($child instanceof Component) {
                $childrenHtml .= $child->render();
            } else {
                $childrenHtml .= htmlspecialchars($child);
            }
        }

        return "<{$this->type}{$attributes}>{$childrenHtml}</{$this->type}>";
    }

    public function getType(): string
    {
        return $this->type;
    }

    public function getProps(): array
    {
        return $this->props;
    }

    public function getChildren(): array
    {
        return $this->children;
    }
} 
<?php
namespace Syntaxx\PHPX\Framework\Core;

/**
 * VRZNO Context - Singleton wrapper around VRZNO
 *
 * CRITICAL: This provides direct VRZNO object access instead of vrzno_eval()!
 *
 * VRZNO provides a 1:1 mirror of the browser's window object,
 * allowing us to manipulate DOM directly from PHP without string evaluation.
 */
class VrznoContext {
    private static ?\Vrzno $window = null;
    private static ?object $document = null;

    /**
     * Initialize VRZNO context (call once at startup)
     */
    public static function initialize(): void {
        if (self::$window === null) {
            self::$window = new \Vrzno;
            self::$document = self::$window->document;
        }
    }

    /**
     * Get window object (VRZNO mirror of browser window)
     */
    public static function getWindow(): \Vrzno {
        if (self::$window === null) {
            self::initialize();
        }
        return self::$window;
    }

    /**
     * Get document object (VRZNO mirror of browser document)
     */
    public static function getDocument(): object {
        if (self::$document === null) {
            self::initialize();
        }
        return self::$document;
    }

    // === DOM Query Methods (VRZNO-native) ===

    /**
     * Get element by ID
     */
    public static function getElementById(string $id): ?object {
        return self::getDocument()->getElementById($id);
    }

    /**
     * Query selector (single element)
     */
    public static function querySelector(string $selector): ?object {
        return self::getDocument()->querySelector($selector);
    }

    /**
     * Query selector all (element list)
     */
    public static function querySelectorAll(string $selector): object {
        return self::getDocument()->querySelectorAll($selector);
    }

    // === DOM Creation Methods (VRZNO-native) ===

    /**
     * Create DOM element
     */
    public static function createElement(string $tagName): object {
        return self::getDocument()->createElement($tagName);
    }

    /**
     * Create text node
     */
    public static function createTextNode(string $text): object {
        return self::getDocument()->createTextNode($text);
    }

    /**
     * Create document fragment
     */
    public static function createDocumentFragment(): object {
        return self::getDocument()->createDocumentFragment();
    }

    // === Active Element Helpers ===

    /**
     * Get currently focused element
     */
    public static function getActiveElement(): ?object {
        return self::getDocument()->activeElement;
    }

    /**
     * Check if specific element has focus
     */
    public static function isElementFocused(object $element): bool {
        $activeElement = self::getActiveElement();
        if (!$activeElement) {
            return false;
        }

        // Compare by reference if possible, otherwise by ID
        try {
            return $activeElement === $element;
        } catch (\Exception $e) {
            // Fallback: compare by ID
            $activeId = $activeElement->id ?? null;
            $elementId = $element->id ?? null;
            return $activeId && $elementId && $activeId === $elementId;
        }
    }

    // === Window Methods ===

    /**
     * Request animation frame
     */
    public static function requestAnimationFrame(callable $callback): void {
        $window = self::getWindow();
        if (method_exists($window, 'requestAnimationFrame')) {
            $window->requestAnimationFrame($callback);
        } else {
            // Fallback to setTimeout
            $window->setTimeout($callback, 16); // ~60fps
        }
    }

    /**
     * Request idle callback
     */
    public static function requestIdleCallback(callable $callback): void {
        $window = self::getWindow();
        if (method_exists($window, 'requestIdleCallback')) {
            $window->requestIdleCallback($callback);
        } else {
            // Fallback to setTimeout
            $window->setTimeout($callback, 0);
        }
    }

    /**
     * Set timeout
     */
    public static function setTimeout(callable $callback, int $milliseconds): void {
        self::getWindow()->setTimeout($callback, $milliseconds);
    }

    /**
     * Clear timeout
     */
    public static function clearTimeout($timeoutId): void {
        self::getWindow()->clearTimeout($timeoutId);
    }

    // === Utility Methods ===

    /**
     * Check if VRZNO is available
     */
    public static function isAvailable(): bool {
        return class_exists('\\Vrzno');
    }

    /**
     * Reset context (for testing)
     */
    public static function reset(): void {
        self::$window = null;
        self::$document = null;
    }
}
<?php
namespace Syntaxx\PHPX\Framework\DOM;

use Syntaxx\PHPX\Framework\Core\VrznoContext;
use Syntaxx\PHPX\Framework\VirtualDOM\VNode;

/**
 * DOM Children Operations (VRZNO-native)
 *
 * Handles creation, insertion, removal of DOM elements using VRZNO
 */
class DOMChildrenOperations {
    /**
     * Create DOM element from VNode
     */
    public static function createDOMElement(VNode $vnode): object {
        if ($vnode->isTextNode()) {
            return VrznoContext::createTextNode($vnode->props['textContent'] ?? '');
        }

        $element = VrznoContext::createElement($vnode->type);

        // Set properties (excluding children)
        $props = array_filter(
            $vnode->props,
            fn($key) => $key !== 'children',
            ARRAY_FILTER_USE_KEY
        );

        DOMPropertyOperations::setAllProperties($element, $props);

        // Add children recursively
        foreach ($vnode->children as $child) {
            $childElement = self::createDOMElement($child);
            $element->appendChild($childElement);
        }

        return $element;
    }

    /**
     * Append child to parent
     */
    public static function appendChild(object $parent, object $child): void {
        $parent->appendChild($child);
    }

    /**
     * Insert child before reference
     */
    public static function insertBefore(
        object $parent,
        object $child,
        ?object $beforeChild
    ): void {
        if ($beforeChild !== null) {
            $parent->insertBefore($child, $beforeChild);
        } else {
            $parent->appendChild($child);
        }
    }

    /**
     * Remove child from parent
     */
    public static function removeChild(object $parent, object $child): void {
        $parent->removeChild($child);
    }

    /**
     * Replace child
     */
    public static function replaceChild(
        object $parent,
        object $newChild,
        object $oldChild
    ): void {
        $parent->replaceChild($newChild, $oldChild);
    }

    /**
     * Update text content
     */
    public static function updateTextContent(object $element, string $text): void {
        $element->textContent = $text;
    }

    /**
     * Clear all children
     */
    public static function removeAllChildren(object $parent): void {
        $parent->innerHTML = '';
    }
}
<?php
namespace Syntaxx\PHPX\Framework\DOM;

use Syntaxx\PHPX\Framework\Core\VrznoContext;

/**
 * DOM Property Operations (VRZNO-native)
 *
 * CRITICAL: NO vrzno_eval()! Only direct VRZNO object manipulation.
 *
 * This module handles all property updates on DOM elements,
 * including special handling for input values to preserve cursor position.
 */
class DOMPropertyOperations {
    /**
     * Set property on VRZNO element
     */
    public static function setProperty(object $element, string $key, mixed $value): void {
        switch ($key) {
            case 'className':
                $element->className = $value;
                break;

            case 'value':
                // CRITICAL: Special handling for inputs to preserve cursor position
                if ($element->tagName === 'INPUT' || $element->tagName === 'TEXTAREA') {
                    $isFocused = VrznoContext::isElementFocused($element);

                    if ($isFocused && method_exists($element, 'selectionStart')) {
                        // Save cursor position
                        try {
                            $start = $element->selectionStart ?? 0;
                            $end = $element->selectionEnd ?? 0;
                        } catch (\Exception $e) {
                            $start = 0;
                            $end = 0;
                        }
                    }

                    $element->value = $value;

                    // Restore cursor position if element still has focus
                    if ($isFocused && method_exists($element, 'setSelectionRange')) {
                        try {
                            $element->setSelectionRange($start ?? 0, $end ?? 0);
                        } catch (\Exception $e) {
                            // Some input types don't support selection
                        }
                    }
                } else {
                    $element->value = $value;
                }
                break;

            case 'checked':
            case 'selected':
            case 'disabled':
            case 'autoFocus':
            case 'readOnly':
            case 'required':
            case 'multiple':
                // Boolean properties
                $element->$key = (bool)$value;
                break;

            case 'style':
                // Handle style object or string
                if (is_array($value)) {
                    foreach ($value as $styleProp => $styleValue) {
                        $element->style->$styleProp = $styleValue;
                    }
                } else {
                    $element->style->cssText = (string)$value;
                }
                break;

            case 'dangerouslySetInnerHTML':
                // Direct innerHTML setting (use sparingly!)
                $element->innerHTML = $value['__html'] ?? '';
                break;

            default:
                // Handle data-* and aria-* attributes
                if (str_starts_with($key, 'data-') || str_starts_with($key, 'aria-')) {
                    $element->setAttribute($key, (string)$value);
                } else if ($key !== 'key' && $key !== 'ref') {
                    // Regular property (skip internal props)
                    try {
                        $element->$key = $value;
                    } catch (\Exception $e) {
                        // If property doesn't exist, try setAttribute
                        $element->setAttribute($key, (string)$value);
                    }
                }
                break;
        }
    }

    /**
     * Remove property from VRZNO element
     */
    public static function removeProperty(object $element, string $key): void {
        switch ($key) {
            case 'className':
                $element->className = '';
                break;

            case 'value':
                $element->value = '';
                break;

            case 'checked':
            case 'selected':
            case 'disabled':
            case 'autoFocus':
            case 'readOnly':
            case 'required':
            case 'multiple':
                $element->$key = false;
                break;

            case 'style':
                $element->style->cssText = '';
                break;

            default:
                if (str_starts_with($key, 'data-') || str_starts_with($key, 'aria-')) {
                    $element->removeAttribute($key);
                }
                break;
        }
    }

    /**
     * Update properties efficiently (diff old vs new)
     *
     * CRITICAL: This is called during reconciliation to update existing elements
     */
    public static function updateProperties(
        object $element,
        array $oldProps,
        array $newProps
    ): void {
        // Remove old props not in new
        foreach ($oldProps as $key => $value) {
            if ($key === 'children' || $key === 'key' || $key === 'ref') continue;
            if (str_starts_with($key, 'on')) continue; // Events handled separately

            if (!array_key_exists($key, $newProps)) {
                self::removeProperty($element, $key);
            }
        }

        // Add/update new props
        foreach ($newProps as $key => $value) {
            if ($key === 'children' || $key === 'key' || $key === 'ref') continue;
            if (str_starts_with($key, 'on')) continue; // Events handled separately

            $oldValue = $oldProps[$key] ?? null;

            // Only update if changed
            if ($oldValue !== $value) {
                self::setProperty($element, $key, $value);
            }
        }
    }

    /**
     * Set all properties on new element
     */
    public static function setAllProperties(object $element, array $props): void {
        foreach ($props as $key => $value) {
            if ($key === 'children' || $key === 'key' || $key === 'ref') continue;
            if (str_starts_with($key, 'on')) continue; // Events handled separately

            self::setProperty($element, $key, $value);
        }
    }
}
