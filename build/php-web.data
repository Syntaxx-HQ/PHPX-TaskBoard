namespace Syntaxx\PHPX\Framework\VirtualDOM;

/**
 * Virtual DOM Node
 *
 * Lightweight PHP representation of a DOM element.
 * Used for efficient diffing and reconciliation.
 */
class VNode {
    public string $type;           // Tag name or component name
    public array $props;           // Properties (excluding children)
    public ?string $key;           // Unique key for reconciliation
    public array $children;        // Child VNodes

    public function __construct(
        string $type,
        array $props = [],
        array $children = [],
        ?string $key = null
    ) {
        $this->type = $type;
        $this->props = $props;
        $this->children = $children;
        $this->key = $key ?? $this->generateKey();
    }

    /**
     * Generate stable key based on type + props
     */
    private function generateKey(): string {
        return md5($this->type . json_encode($this->props));
    }

    /**
     * Check if this is a text node
     */
    public function isTextNode(): bool {
        return $this->type === 'TEXT_NODE';
    }

    /**
     * Check if this is a component (vs HTML element)
     */
    public function isComponent(): bool {
        return !$this->isHtmlElement() && !$this->isTextNode();
    }

    /**
     * Check if this is an HTML element
     */
    public function isHtmlElement(): bool {
        $htmlTags = [
            'div', 'span', 'input', 'button', 'form', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
            'p', 'ul', 'li', 'ol', 'table', 'tr', 'td', 'th', 'thead', 'tbody', 'tfoot',
            'select', 'option', 'textarea', 'a', 'img', 'header', 'footer', 'section',
            'nav', 'article', 'aside', 'main', 'label', 'strong', 'em', 'code', 'pre',
            'br', 'hr', 'small', 'mark', 'del', 'ins', 'sub', 'sup'
        ];
        return in_array(strtolower($this->type), $htmlTags);
    }

    /**
     * Check if this VNode is different from another
     * Used for efficient diffing
     */
    public function isDifferent(VNode $other): bool {
        // Quick type/key check
        if ($this->type !== $other->type) return true;
        if ($this->key !== $other->key) return true;

        // Compare props (skip children and event handlers)
        foreach ($this->props as $key => $value) {
            if ($key === 'children') continue;
            if (str_starts_with($key, 'on')) continue; // Event handlers

            $otherValue = $other->props[$key] ?? null;

            // Special handling for functions (can't compare directly)
            if (is_callable($value) && is_callable($otherValue)) {
                continue;
            }

            if ($value !== $otherValue) return true;
        }

        // Check for removed props
        foreach ($other->props as $key => $value) {
            if ($key === 'children') continue;
            if (str_starts_with($key, 'on')) continue;

            if (!isset($this->props[$key])) return true;
        }

        return false;
    }

    /**
     * Clone this VNode with new props
     */
    public function cloneWith(array $newProps): VNode {
        return new VNode(
            $this->type,
            array_merge($this->props, $newProps),
            $this->children,
            $this->key
        );
    }

    /**
     * Get string representation (for debugging)
     */
    public function __toString(): string {
        if ($this->isTextNode()) {
            return 'TEXT: ' . ($this->props['textContent'] ?? '');
        }

        $childCount = count($this->children);
        $propsStr = json_encode(array_slice($this->props, 0, 3));
        return "{$this->type}[{$childCount} children, {$propsStr}]";
    }
}
<?php
namespace Syntaxx\PHPX\Framework\VirtualDOM;

use Syntaxx\PHPX\Framework\Component;

/**
 * VNode Builder - Converts Component objects to VNode tree
 *
 * This builds the Virtual DOM tree from PHPX Component output
 */
class VNodeBuilder {
    /**
     * Build VNode tree from component
     */
    public static function build(mixed $component): VNode {
        // Handle primitives (string, number, bool)
        if (is_scalar($component)) {
            return VText::create((string)$component);
        }

        // Handle null/false (empty)
        if ($component === null || $component === false) {
            return VText::create('');
        }

        // Handle Component object
        if ($component instanceof Component) {
            return self::buildFromComponent($component);
        }

        // Handle array (list of children)
        if (is_array($component)) {
            // Create fragment
            $children = array_map([self::class, 'build'], $component);
            return new VNode('FRAGMENT', [], $children);
        }

        // Unknown type - convert to string
        return VText::create((string)$component);
    }

    /**
     * Build VNode from Component object
     */
    private static function buildFromComponent(Component $component): VNode {
        $type = $component->type;
        $props = $component->props ?? [];

        // List of standard HTML elements (should not be treated as function components)
        $htmlElements = ['header', 'footer', 'main', 'nav', 'section', 'article', 'aside', 'time',
                       'button', 'input', 'form', 'div', 'span', 'a', 'p', 'h1', 'h2', 'h3',
                       'h4', 'h5', 'h6', 'ul', 'ol', 'li', 'table', 'tr', 'td', 'th', 'img',
                       'video', 'audio', 'canvas', 'svg', 'path', 'g', 'circle', 'rect'];

        // Check if this is a FUNCTION component that needs to be called
        if (function_exists($type) && !in_array(strtolower($type), $htmlElements)) {
            echo "ðŸ”· VNodeBuilder: Calling function component: {$type}";

            // Set current component function for useState hooks
            \Syntaxx\PHPX\Framework\Runtime::setCurrentComponentFunction($type);

            // Prepare props with children
            $propsWithChildren = $props;
            $propsWithChildren['children'] = $component->children;

            // Call the function component
            $result = $type($propsWithChildren);

            // Clear current component function
            \Syntaxx\PHPX\Framework\Runtime::setCurrentComponentFunction(null);

            echo "ðŸ”· VNodeBuilder: Function returned: " . (is_object($result) ? get_class($result) : gettype($result));

            // Build VNode from the result
            return self::build($result);
        }

        // Regular HTML element - build VNode directly
        $children = [];

        // Get children from Component->children property
        $componentChildren = $component->children ?? [];
        if (!empty($componentChildren)) {
            $children = self::normalizeChildren($componentChildren);
        }

        // Also check props['children'] (for compatibility)
        if (isset($props['children']) && empty($children)) {
            $childrenProp = $props['children'];

            if (is_array($childrenProp)) {
                $children = self::normalizeChildren($childrenProp);
            } else {
                $children = [self::build($childrenProp)];
            }

            // Remove children from props (stored separately in VNode)
            unset($props['children']);
        }

        // Extract key
        $key = $props['key'] ?? null;
        if ($key !== null) {
            unset($props['key']); // Remove from props
        }

        return new VNode($type, $props, $children, $key);
    }

    /**
     * Normalize children (flatten arrays, filter nulls)
     */
    public static function normalizeChildren(array $children): array {
        $normalized = [];

        foreach ($children as $child) {
            if ($child === null || $child === false) {
                continue; // Skip empty
            }

            if (is_array($child)) {
                // Flatten nested arrays
                $normalized = array_merge($normalized, self::normalizeChildren($child));
            } else {
                $normalized[] = self::build($child);
            }
        }

        return $normalized;
    }

    /**
     * Build VNode from HTML string (legacy support)
     */
    public static function buildFromHTML(string $html): VNode {
        // Simple parser - just wrap in div
        // TODO: Implement proper HTML parser if needed
        return new VNode('div', ['dangerouslySetInnerHTML' => ['__html' => $html]], []);
    }
}
