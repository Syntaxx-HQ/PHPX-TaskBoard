use Syntaxx\PHPX\Framework\Component;
use function Syntaxx\PHPX\Framework\useState;

require_once "Components/Board.php";
require_once "Components/BenchmarkApp.php";

function App() {
    [$showBenchmark, $setShowBenchmark] = useState(false);

    return (
        <div>
            <div style="padding: 20px; text-align: center; background: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                <button
                    onClick={fn() => $setShowBenchmark(!$showBenchmark)}
                    style="padding: 10px 20px; font-size: 16px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 4px;"
                >
                    {$showBenchmark ? 'Show Task Board' : 'Show VRZNO Benchmark'}
                </button>
            </div>

            {$showBenchmark ? <BenchmarkApp /> : <Board />}
        </div>
    );
}<?php
use Syntaxx\PHPX\Framework\Component;
use function Syntaxx\PHPX\Framework\useState;
function BenchmarkApp()
{
    [$results, $setResults] = useState([]);
    [$isRunning, $setIsRunning] = useState(false);
    $runBenchmark = function () use ($setResults, $setIsRunning) {
        $setIsRunning(true);
        $setResults([]);
        // Get VRZNO window and document
        $window = new \Vrzno();
        $document = $window->document;
        // Create test container
        $container = $document->getElementById('benchmark-container');
        if (!$container) {
            $container = $document->createElement('div');
            $container->id = 'benchmark-container';
            $container->style->display = 'none';
            $document->body->appendChild($container);
        }
        $benchmarkResults = [];
        // ===================================
        // Test 1: innerHTML set (direct vs eval)
        // ===================================
        $iterations = 1000;
        $testHtml = '<div class="test"><span>Hello World</span></div>';
        // Direct VRZNO access
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            $container->innerHTML = $testHtml;
        }
        $directTime = (microtime(true) - $startTime) * 1000;
        // vrzno_eval
        $escapedHtml = json_encode($testHtml);
        $startTime = microtime(true);
        for ($i = 0; $i < $iterations; $i++) {
            vrzno_eval("document.getElementById('benchmark-container').innerHTML = {$escapedHtml}");
        }
        $evalTime = (microtime(true) - $startTime) * 1000;
        $benchmarkResults[] = ['test' => 'innerHTML Assignment', 'iterations' => $iterations, 'direct' => round($directTime, 2), 'eval' => round($evalTime, 2), 'speedup' => round($evalTime / $directTime, 2)];
        // ===================================
        // Test 2: Property reads
        // ===================================
        $iterations = 10000;
        $container->innerHTML = '<input id="test-input" value="test" />';
        $input = $document->getElementById('test-input');
