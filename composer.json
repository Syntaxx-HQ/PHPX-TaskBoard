{
    "repositories": [
        {
            "type": "path",
            "url": "../PHPX-Framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../PHPX-BuildTools",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../PHPX-WebAssemblyPacker",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../PHPX-Compiler",
            "options": {
                "symlink": true
            }
        }
    ],
    "name": "syntaxx/phpx-sample-task-board",
    "description": "PHPX task board",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Bohuslav Simek",
            "email": "bohuslav@simek.si"
        }
    ],
    "require": {
        "syntaxx/wasm-php-runtime-vrzno": "8.3.0",
        "syntaxx/phpx-framework": "*"
    },
    "require-dev": {
        "syntaxx/phpx-build-tools": "*",
        "syntaxx/webassembly-packer": "*",
        "syntaxx/phpx-compiler": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "bump-after-update": true,
        "sort-packages": true,
        "allow-plugins": {
            "syntaxx/wasm-php-runtime-vrzno": true
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:9001 -t public"
        ],
        "wasm:export": "phpx-build export",
        "wasm:pack": "phpx-build pack",
        "wasm": "phpx-build build",
        "wasm:dev": "phpx-build build --dev --create-html-maps",
        "wasm:watch": [
            "Composer\\Config::disableProcessTimeout",
            "phpx-build watch"
        ],
        "wasm:watch:dev": [
            "Composer\\Config::disableProcessTimeout",
            "phpx-build watch --dev"
        ]
    },
    "extra": {
        "php-wasm": {
            "target-dir": "build"
        }
    }
}
